+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -167,6 +167,8 @@ public:
 
     preferred_max_frame_rate =
         Config::getInstance().getOption<int>("d3d11.preferredMaxFrameRate", 0);
+    background_max_frame_rate =
+        Config::getInstance().getOption<int>("d3d11.backgroundMaxFrameRate", 0);
     wsi::WsiMode current_mode;
     if (wsi::getCurrentDisplayMode(monitor_, &current_mode) &&
         current_mode.refreshRate.denominator != 0 &&
@@ -750,12 +752,40 @@ public:
     if (should_exit_fs)
       SetFullscreenState(FALSE, nullptr);
 
+    int background_frame_rate = 0;
+    if (background_max_frame_rate > 0 &&
+        (window_minimized || !::IsWindowVisible(hWnd))) {
+      background_frame_rate = preferred_max_frame_rate > 0
+                                  ? std::min(preferred_max_frame_rate,
+                                             background_max_frame_rate)
+                                  : background_max_frame_rate;
+    }
+    ULONGLONG background_present_started = 0;
+    if (background_frame_rate > 0 &&
+        !(PresentFlags & DXGI_PRESENT_DO_NOT_WAIT))
+      background_present_started = ::GetTickCount64();
+    // Drawable pacing alone can still allow excess submissions. Include the
+    // queue wait in the background period and sleep outside the device lock.
+    auto pace_background_present = [background_frame_rate, PresentFlags,
+                                   background_present_started] {
+      if (background_frame_rate > 0 &&
+          !(PresentFlags & DXGI_PRESENT_DO_NOT_WAIT)) {
+        UINT rate = static_cast<UINT>(background_frame_rate);
+        UINT minimum_ms = (1000u + rate - 1u) / rate;
+        ULONGLONG elapsed_ms = ::GetTickCount64() - background_present_started;
+        if (elapsed_ms < minimum_ms)
+          ::Sleep(static_cast<DWORD>(minimum_ms - elapsed_ms));
+      }
+    };
+
     std::unique_lock<d3d11_device_mutex> lock(device_->mutex);
 
     device_context_->PrepareFlush();
     if (hr == DXGI_STATUS_OCCLUDED) {
       // flush commands without presenting
       device_context_->Commit();
+      lock.unlock();
+      pace_background_present();
       return hr;
     }
 
