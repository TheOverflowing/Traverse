 # d3d11.preferredMaxFrameRate = 60
 
+
+# Limit real presentation calls while the swapchain window is minimized or
+# hidden. Visible windows keep their frame rate when another window has focus.
+# The foreground frame limit and the application's sync interval remain upper bounds.
+# Background blocking Present calls sleep for any time left in the frame
+# period after queue waits. PRESENT_TEST and PRESENT_DO_NOT_WAIT do not gain
+# that sleep.
+#
+# Supported values: Any non-negative integer; 0 disables the background limit.
+
+# d3d11.backgroundMaxFrameRate = 0
+
 # Adjust MetalFX Sptial Upscaling factor.
 # It is multiplied by source output width & height to get the
 # final output resolution. 
diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 5e9404d..555ba2f 100644
