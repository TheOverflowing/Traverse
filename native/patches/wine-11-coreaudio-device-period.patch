+static HRESULT get_device_period_frame_range(AudioDeviceID device, EDataFlow flow,
+                                             unsigned int *minimum, unsigned int *maximum)
+{
+    AudioObjectPropertyAddress address = {kAudioDevicePropertyBufferFrameSizeRange,
+                                         get_scope(flow), kAudioObjectPropertyElementMain};
+    AudioValueRange range;
+    UInt32 size = sizeof(range);
+    OSStatus status = AudioObjectGetPropertyData(device, &address, 0, NULL, &size, &range);
+    if (status != noErr) return osstatus_to_hresult(status);
+    *minimum = range.mMinimum;
+    *maximum = range.mMaximum;
+    return S_OK;
+}
+
+static HRESULT get_device_period_frame_size(AudioDeviceID device, EDataFlow flow, unsigned int *frames)
+{
+    AudioObjectPropertyAddress address = {kAudioDevicePropertyBufferFrameSize,
+                                         get_scope(flow), kAudioObjectPropertyElementMain};
+    UInt32 size = sizeof(*frames);
+    OSStatus status = AudioObjectGetPropertyData(device, &address, 0, NULL, &size, frames);
+    return status == noErr ? S_OK : osstatus_to_hresult(status);
+}
+
+static HRESULT set_device_period_frame_size(AudioDeviceID device, EDataFlow flow, unsigned int frames)
+{
+    AudioObjectPropertyAddress address = {kAudioDevicePropertyBufferFrameSize,
+                                         get_scope(flow), kAudioObjectPropertyElementMain};
+    OSStatus status = AudioObjectSetPropertyData(device, &address, 0, NULL, sizeof(frames), &frames);
+    return status == noErr ? S_OK : osstatus_to_hresult(status);
+}
+
+static HRESULT get_device_sample_rate(AudioDeviceID device, EDataFlow flow, unsigned int *rate)
+{
+    AudioObjectPropertyAddress address = {kAudioDevicePropertyNominalSampleRate,
+                                         get_scope(flow), kAudioObjectPropertyElementMain};
+    Float64 sample_rate;
+    UInt32 size = sizeof(sample_rate);
+    OSStatus status = AudioObjectGetPropertyData(device, &address, 0, NULL, &size, &sample_rate);
+    if (status != noErr) return osstatus_to_hresult(status);
+    *rate = sample_rate;
+    return S_OK;
+}
